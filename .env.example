# Copy to .env.local for local dev. Never commit real keys.
# In production these go in Railway → project → Variables.

# Google AI Studio (https://aistudio.google.com/apikey) — free tier.
# The AI SDK's own name for this is GOOGLE_GENERATIVE_AI_API_KEY; either works.
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys) — free tier.
GROQ_API_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Optional: leave empty
# and no analytics script is loaded at all. NEXT_PUBLIC_ prefix is required —
# this one is read in the browser, so treat it as public, not a secret.
# Set it in Railway only, so local dev doesn't pollute your traffic data.
NEXT_PUBLIC_GA_ID=

# Better Stack Error Tracking DSN for scrubbed failures and controlled lifecycle
# events. Optional: monitoring remains disabled when blank. This identifier is
# intentionally browser-visible; it is not an account password or API key.
NEXT_PUBLIC_BETTER_STACK_DSN=

# Agent Orchestration Demo limits. Missing, blank, or invalid values use the
# shown cost-safe defaults; explicit values are clamped to hard application
# bounds. These are private server settings and never enter the browser bundle.
AGENT_RUN_TIMEOUT_MS=180000
AGENT_CALL_TIMEOUT_MS=60000
AGENT_MAX_RESEARCHERS=3
AGENT_MAX_INPUT_LENGTH=2000
AGENT_RUNS_PER_DAY=5
AGENT_GLOBAL_RUNS_PER_DAY=200
AGENT_MAX_CONCURRENT_PER_IP=1
AGENT_MAX_CONCURRENT_GLOBAL=6
AGENT_PLANNER_OUTPUT_TOKENS=1500
AGENT_RESEARCHER_OUTPUT_TOKENS=500
AGENT_CRITIC_OUTPUT_TOKENS=1500
AGENT_WRITER_OUTPUT_TOKENS=4000

# Optional. Number of trusted proxies in front of this process, used to pick the
# right entry out of X-Forwarded-For for rate limiting. Defaults to 1, which is
# correct on Railway (its edge proxy appends the real client IP). Only raise it
# if you put another trusted proxy or CDN in front of Railway — setting it too
# high reads a visitor-supplied value and makes the per-IP cap forgeable.
TRUSTED_PROXY_HOPS=1

# Secret used to create non-reversible, stable rate-limit keys without storing
# raw visitor IP addresses. Generate independently with: openssl rand -base64 48
# Agent daily counters use RATE_LIMIT_DATA_DIR, then X_RADAR_DATA_DIR, then .data.
RATE_LIMIT_HASH_SECRET=
RATE_LIMIT_DATA_DIR=/data

# Conversation Opportunity Radar. Public post data is sourced from X. All X
# requests run only in the private server scheduler.
X_BEARER_TOKEN=
X_OWNER_USERNAME=AliMajed93
## Keep false until X has approved the revised conversation-analysis use case
## described in docs/x-api-compliance.md. The server refuses to scan otherwise.
X_RADAR_USE_CASE_APPROVED=false
X_REFRESH_INTERVAL_HOURS=240
X_MAX_POSTS_PER_SCAN=30
X_LOOKBACK_HOURS=24
X_MONTHLY_REQUEST_LIMIT=104
# Owner-only manual scans have their own hard ceiling of 100 and also count
# toward X_MONTHLY_REQUEST_LIMIT. Generate at least 32 random bytes, for example:
# openssl rand -base64 48
X_RADAR_ADMIN_TOKEN=
X_MANUAL_MONTHLY_REQUEST_LIMIT=100
# X Content may never remain visible for more than 24 hours. Automatic scans
# remain every 240 hours; the Radar intentionally goes empty after retention
# expires until a manual scan or the next scheduled scan. Missing or invalid
# values fall back to a 240-hour scan, 30 candidates,
# 24-hour lookback, 14 total scans, 10 manual scans, and 12-hour retention.
X_CONTENT_MAX_AGE_HOURS=12
# Set this to the Railway volume mount path in production.
X_RADAR_DATA_DIR=/data
# Radar analysis is local only. Do not add an external AI-processing flag or
# use X Content to train/fine-tune a model without a new policy and legal review.
