# Copy to .env.local for local dev. Never commit real keys.
# In production these go in Railway → project → Variables.

# Google AI Studio (https://aistudio.google.com/apikey) — free tier.
# The AI SDK's own name for this is GOOGLE_GENERATIVE_AI_API_KEY; either works.
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys) — free tier.
GROQ_API_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Optional: leave empty
# and no analytics script is loaded at all. NEXT_PUBLIC_ prefix is required —
# this one is read in the browser, so treat it as public, not a secret.
# Set it in Railway only, so local dev doesn't pollute your traffic data.
NEXT_PUBLIC_GA_ID=

# Better Stack Error Tracking DSN. Optional: monitoring remains disabled when
# blank. This identifier is intentionally browser-visible; it is not an account
# password or API key. Error payloads are scrubbed before they leave the app.
NEXT_PUBLIC_BETTER_STACK_DSN=

# Optional. End-to-end ceiling for one agent run, in milliseconds. Defaults to
# 180000 (3 minutes). Individual model calls are capped separately at 60s in
# lib/orchestrator.ts; this bounds the whole planner → researchers → critic →
# writer chain so one run can't hold a stream open for many minutes.
AGENT_RUN_TIMEOUT_MS=

# Optional. Number of trusted proxies in front of this process, used to pick the
# right entry out of X-Forwarded-For for rate limiting. Defaults to 1, which is
# correct on Railway (its edge proxy appends the real client IP). Only raise it
# if you put another trusted proxy or CDN in front of Railway — setting it too
# high reads a visitor-supplied value and makes the per-IP cap forgeable.
TRUSTED_PROXY_HOPS=
