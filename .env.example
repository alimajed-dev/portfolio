# Copy to .env.local for local dev. Never commit real keys.
# In production these go in Railway → project → Variables.

# Google AI Studio (https://aistudio.google.com/apikey) — free tier.
# The AI SDK's own name for this is GOOGLE_GENERATIVE_AI_API_KEY; either works.
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys) — free tier.
GROQ_API_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Optional: leave empty
# and no analytics script is loaded at all. NEXT_PUBLIC_ prefix is required —
# this one is read in the browser, so treat it as public, not a secret.
# Set it in Railway only, so local dev doesn't pollute your traffic data.
NEXT_PUBLIC_GA_ID=
